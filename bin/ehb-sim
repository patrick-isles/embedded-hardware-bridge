#!/usr/bin/env python3
# ==============================================================================
# Tool: ehb-sim
# Purpose: Hardware-in-the-Loop (HIL) Microcontroller Serial Telemetry Simulator
# Target: Linux Pseudo-Terminal (PTY) UART Loopback
# Author: Patrick Isles (https://github.com/patrick-isles)
# License: MIT
# ==============================================================================

import os, sys, time, struct, math, random, argparse, termios, tty

# Standard CRC-16-CCITT (Polynomial 0x1021, Init 0xFFFF)
def crc16_ccitt(data: bytes, poly=0x1021, init=0xFFFF) -> int:
    crc = init
    for b in data:
        crc ^= (b << 8)
        for _ in range(8):
            if crc & 0x8000:
                crc = ((crc << 1) ^ poly) & 0xFFFF
            else:
                crc = (crc << 1) & 0xFFFF
    return crc

# Packet Structure:
# 2 bytes: SYNC (0xAA, 0x55)
# 1 byte:  PAYLOAD_LEN (14 bytes)
# Payload (14 bytes):
#   - Voltage_mV:   uint16 (e.g. 5000 mV)
#   - Current_mA:   uint16 (e.g. 250 mA)
#   - Raw_ADC:      uint16 (12-bit ADC, 0-4095)
#   - Temp_cdegC:   int16  (e.g. 2540 = 25.40 C)
#   - GPIO_Register:uint8  (8 digital pins)
#   - Fault_Flags:  uint8  (bit 0: OverVoltage, bit 1: Brownout, bit 2: OverTemp)
#   - Sequence_ID:  uint32 (Monotonic packet counter)
# 2 bytes: CRC-16-CCITT
# Total Frame Length: 19 bytes

SYNC_HEADER = bytes([0xAA, 0x55])
PAYLOAD_FORMAT = ">HHHhBBI" # Big-endian
PAYLOAD_LEN = struct.calcsize(PAYLOAD_FORMAT)

def run_simulator(link_path="/tmp/ehb-virtual-uart", rate_hz=10, fault_mode=None):
    master, slave = os.openpty()
    tty.setraw(master)
    tty.setraw(slave)
    slave_name = os.ttyname(slave)

    # Create convenient symlink
    if os.path.exists(link_path) or os.path.islink(link_path):
        os.unlink(link_path)
    os.symlink(slave_name, link_path)

    print(f"\033[1m\033[36m[ehb-sim]\033[0m Virtual Microcontroller Serial Bridge Online")
    print(f"  • PTY Master FD: {master}")
    print(f"  • Slave Device:  {slave_name}")
    print(f"  • Symlink Target: \033[1m{link_path}\033[0m")
    print(f"  • Sampling Rate: {rate_hz} Hz")
    if fault_mode:
        print(f"  • \033[31mFAULT INJECTION ENGAGED: {fault_mode.upper()}\033[0m")
    print(f"  • Streaming binary packets (SYNC 0xAA55, CRC-16 validated)...")
    print("\033[38;5;242mPress Ctrl+C to terminate simulation.\033[0m\n")

    seq = 0
    t0 = time.time()
    dt = 1.0 / rate_hz

    try:
        while True:
            elapsed = time.time() - t0
            
            # Simulated electrical parameters
            # Nominal 5.0V with 60Hz AC noise ripple + dynamic load shift
            base_voltage = 5.0
            if fault_mode == "overvoltage":
                base_voltage = 5.8 + random.uniform(-0.1, 0.1)
            elif fault_mode == "brownout":
                base_voltage = 4.1 + random.uniform(-0.1, 0.1)
            else:
                base_voltage += 0.08 * math.sin(2 * math.pi * 0.5 * elapsed) + random.uniform(-0.02, 0.02)

            voltage_mv = int(max(0, base_voltage * 1000))
            raw_adc = int(min(4095, (base_voltage / 5.0) * 4095))

            # Dynamic load resistance: ~20 ohms nominal -> Current I = V / R
            nominal_resistance = 20.0 + 2.0 * math.cos(elapsed * 0.3)
            current_ma = int((base_voltage / nominal_resistance) * 1000)

            # Thermal sensor: ambient 24C + Joule heating rise proportional to I^2 * R
            joule_heat = (current_ma / 1000.0) ** 2 * 0.05
            temp_c = 24.0 + (elapsed * 0.05) % 15.0 + joule_heat
            if fault_mode == "overtemp":
                temp_c = 85.0 + random.uniform(0, 5.0)
            temp_cdeg = int(temp_c * 100)

            # GPIO Register simulation (8 channels)
            # Pin 0: 1Hz Heartbeat pulse
            # Pin 1: 0.5Hz Clock
            # Pin 2: Load Enable
            # Pin 3..7: Pseudorandom digital bus
            gpio = 0
            if int(elapsed * 2) % 2 == 1:
                gpio |= (1 << 0) # Heartbeat
            if int(elapsed) % 2 == 1:
                gpio |= (1 << 1) # Clock
            gpio |= (1 << 2)     # Load active
            if current_ma > 240:
                gpio |= (1 << 3) # High-current interlock flag

            # Fault status bits
            fault_byte = 0
            if base_voltage > 5.3:
                fault_byte |= 0x01 # Over-voltage
            if base_voltage < 4.5:
                fault_byte |= 0x02 # Brownout
            if temp_c > 75.0:
                fault_byte |= 0x04 # Over-temp

            # Pack payload
            payload = struct.pack(PAYLOAD_FORMAT, voltage_mv, current_ma, raw_adc, temp_cdeg, gpio, fault_byte, seq)
            crc = crc16_ccitt(payload)

            packet = SYNC_HEADER + bytes([PAYLOAD_LEN]) + payload + struct.pack(">H", crc)

            os.write(master, packet)
            seq += 1
            time.sleep(dt)

    except KeyboardInterrupt:
        print("\n[ehb-sim] Terminating virtual hardware bridge...")
    finally:
        if os.path.islink(link_path):
            os.unlink(link_path)
        os.close(master)
        os.close(slave)

def main():
    parser = argparse.ArgumentParser(description="HIL Microcontroller Serial Telemetry Simulator")
    parser.add_argument("-l", "--link", default="/tmp/ehb-virtual-uart", help="Symlink path for virtual UART")
    parser.add_argument("-r", "--rate", type=int, default=10, help="Packet transmission rate in Hz")
    parser.add_argument("-f", "--fault", choices=["overvoltage", "brownout", "overtemp"], help="Inject simulated electrical fault")
    args = parser.parse_args()

    run_simulator(link_path=args.link, rate_hz=args.rate, fault_mode=args.fault)

if __name__ == "__main__":
    main()
